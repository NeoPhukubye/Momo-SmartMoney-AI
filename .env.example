# MoMo SmartMoney AI - Environment Variables
# Copy this to .env and fill in your values

# ===== APPLICATION =====
SECRET_KEY=your-secret-key-here
DATABASE_URL=sqlite+aiosqlite:///./smartmoney.db
# For Render production (auto-set from render.yaml):
# DATABASE_URL=postgresql://user:pass@host:5432/smartmoney
APP_ENV=development

# ===== GOOGLE GEMINI AI =====
# Get your key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ===== MTN MoMo API =====
# Register at: https://momodeveloper.mtn.com
MOMO_API_BASE_URL=https://sandbox.momodeveloper.mtn.com
MOMO_COLLECTION_PRIMARY_KEY=your-collection-primary-key
MOMO_DISBURSEMENT_PRIMARY_KEY=your-disbursement-primary-key
MOMO_API_USER=your-api-user-uuid
MOMO_API_KEY=your-api-key
MOMO_ENVIRONMENT=sandbox

# ===== AFRICA'S TALKING (USSD) =====
# Register at: https://africastalking.com
AT_USERNAME=sandbox
AT_API_KEY=your-africas-talking-api-key

# ===== CORS =====
# Update with your Render URLs after deployment
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ===== FRONTEND =====
# Set on Render static site build env
VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=930989766959-i76ac8irvvtl5qjgioi7ha32b3hl7it1.apps.googleusercontent.com